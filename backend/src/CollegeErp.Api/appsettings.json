{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MasterConnectionString": "Data Source=data/master.db",
    "SqliteDirectory": "data/colleges",
    "TenantDatabasePrefix": "college_",
    "MigrateTenantsOnStartup": true
  },
  "Jwt": {
    "Issuer": "college-erp",
    "Audience": "college-erp",
    "Secret": "dev-only-secret-change-me-0123456789-abcdefghijkl",
    "ExpiryMinutes": 720
  },
  "Bootstrap": {
    "SuperAdminEmail": "admin@platform.local",
    "SuperAdminPassword": "Admin@12345"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
